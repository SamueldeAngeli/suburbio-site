# Desenvolvimento: copie para .env.local. VPS: copie para .env.production.local.
# Nunca versionar secrets. Referência completa: docs/ENVIRONMENT.md.
# NODE_ENV não entra aqui: next build/next start e o PM2 definem production.
# Desabilitado por padrão: site público continua disponível sem integrações.
AUTH_ENABLED=false
SUBURBIO_API_ENABLED=false

# Origem pública do SITE. Em produção, HTTPS obrigatório (ex.: https://suburbioroleplay.com, sem barra final).
AUTH_URL=http://localhost:3002
# ≥ 32 caracteres aleatórios. Gerar: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=
# Opcional: chave anterior durante rotação; remover após expirar sessões antigas.
AUTH_SECRET_PREVIOUS=
# Habilitar cargos apenas após aplicar o contrato aprovado na API.
DISCORD_ROLE_AUTH_ENABLED=false
# DISCORD_GUILD_ID=<ID do servidor Discord; omitir usa o servidor Subúrbio>
DISCORD_ROLE_REFRESH_SECONDS=30
# Aplicação OAuth do Discord. O redirect deve ser exatamente AUTH_URL + /api/auth/callback/discord
# e estar cadastrado no Developer Portal (OAuth2 → Redirects).
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:3002/api/auth/callback/discord

# VPS (API na mesma máquina): http://127.0.0.1:3000 — o proxy público bloqueia /internal/*,
# então a URL pública da API NÃO funciona para o site.
# PC de desenvolvimento: API local em http://127.0.0.1:3000.
SUBURBIO_API_URL=http://127.0.0.1:3000
SITE_SERVICE_ID=site
# ≥ 32; igual a SITE_SERVICE_SECRET da API e diferente de todos os outros secrets.
SITE_SERVICE_SECRET=
# Timeout explícito de cada chamada Site → API (500–30000 ms).
SUBURBIO_API_TIMEOUT_MS=5000

# LiveKit (compartilhamento de tela). Chaves ficam somente no servidor.
# INTERNAL: endereço usado pelo SDK no servidor (loopback/rede privada; http/ws permitidos só aí).
#   VPS: http://127.0.0.1:7880
# PUBLIC: endereço entregue ao navegador. Em produção, obrigatoriamente wss:// em domínio público.
#   VPS: wss://tela.suburbioroleplay.com
LIVEKIT_ENABLED=false
LIVEKIT_INTERNAL_URL=http://127.0.0.1:7880
LIVEKIT_PUBLIC_URL=ws://127.0.0.1:7880
# Mesmo par key/secret declarado em `keys:` do livekit.yaml.
LIVEKIT_API_KEY=
# Produção: 32+ caracteres.
LIVEKIT_API_SECRET=

# Redis próprio do site (opcional, recomendado na VPS). Estado efêmero: rate limit, locks, salas de tela.
# Sem REDIS_URL: modo instância única (memória do processo). Nunca reutilizar o prefixo da API.
# VPS: redis://127.0.0.1:6379 (mesmo servidor da API, prefixo distinto).
REDIS_URL=
REDIS_KEY_PREFIX=suburbio:site:
