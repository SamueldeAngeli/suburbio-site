{
  "name": "suburbio-rp",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint app components lib auth.ts instrumentation.ts tests --max-warnings=0",
    "test:watch": "vitest",
    "verify:client": "node scripts/verify-client.mjs",
    "test:http": "node --test --test-concurrency=1 tests/http.smoke.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "next": "^16.2.0",
    "next-auth": "5.0.0-beta.32",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "server-only": "0.0.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "10.11.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "8.70.1",
    "vitest": "5.0.2"
  }
}
